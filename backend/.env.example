# =============================================
# ECOBIN BACKEND - Environment Variables
# =============================================
# Iss file ko copy karke .env naam do aur apni values bharo
# cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database (agar use kar rahe ho)
DATABASE_URL=postgresql://username:password@localhost:5432/ecobin_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecobin_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Secret (koi bhi random string dalo)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (CORS ke liye)
FRONTEND_URL=http://localhost:3000
